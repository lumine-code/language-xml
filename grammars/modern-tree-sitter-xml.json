{
  "name": "XML",
  "scopeName": "text.xml",
  "type": "modern-tree-sitter",
  "parser": "tree-sitter-xml",
  "injectionRegex": "^xml$",
  // The TextMate grammar matches the XML declaration, and a first-line match is
  // worth 0.5 against the 0.1 that prefers Tree-sitter — so without this every
  // file that opens with `<?xml …?>`, which is very nearly all of them, went to
  // the TextMate grammar instead.
  "firstLineRegex": ["^<\\?xml\\s+version\\s*=", "vim\\b.*\\bset\\b.*\\b(filetype|ft|syntax)=xml"],
  "fileTypes": [
    "aiml",
    "atom",
    "axml",
    "bpmn",
    "config",
    "cpt",
    "csl",
    "csproj",
    "csproj.user",
    "dae",
    "dia",
    "dita",
    "ditamap",
    "dtml",
    "fodg",
    "fodp",
    "fods",
    "fodt",
    "fsproj",
    "fxml",
    "gir",
    "glade",
    "gpx",
    "graphml",
    "icls",
    "iml",
    "isml",
    "jmx",
    "jsp",
    "kml",
    "kst",
    "launch",
    "menu",
    "mxml",
    "nunit",
    "nuspec",
    "opml",
    "owl",
    "pom",
    "ppj",
    "proj",
    "pt",
    "pubxml",
    "pubxml.user",
    "rdf",
    "rng",
    "rss",
    "sdf",
    "shproj",
    "siml",
    "sld",
    "storyboard",
    "StyleCop",
    "svg",
    "targets",
    "tld",
    "vbox",
    "vbox-prev",
    "vbproj",
    "vbproj.user",
    "vcproj",
    "vcproj.filters",
    "vcxproj",
    "vcxproj.filters",
    "wixmsp",
    "wixmst",
    "wixobj",
    "wixout",
    "wsdl",
    "wxs",
    "xaml",
    "xbl",
    "xib",
    "xlf",
    "xliff",
    "xml",
    "xpdl",
    "xsd",
    "xul",
    "ui"
  ],
  "comments": {
    "start": "<!-- "
  },
  "treeSitter": {
    "parserSource": "github:tree-sitter-grammars/tree-sitter-xml/xml#v0.7.0",
    "wasmBuildTool": "tree-sitter-cli#v0.26.11",
    "grammar": "tree-sitter-xml/tree-sitter-xml.wasm",
    "highlightsQuery": "tree-sitter-xml/highlights.scm",
    "foldsQuery": "tree-sitter-xml/folds.scm"
  }
}
